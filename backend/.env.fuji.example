# Copy to backend/.env to use a dedicated Fuji database; set the address after deploy.
LEDGER_MODE=evm
EVM_RPC=https://api.avax-test.network/ext/bc/C/rpc
EVM_CHAIN_ID=43113
EVM_CONTRACT_ADDRESS=
EVM_DEPLOYMENT_BLOCK=
# Server-only dedicated test wallet key; never put this in VITE_* or commit it.
EVM_PRIVATE_KEY=
EVM_AUTO_DEPLOY=0
DATABASE_URL=sqlite:///./fruitchain-fuji.db
STORAGE_DIR=./storage/fuji
JWT_SECRET=replace-with-a-long-random-secret
FUSION=min
AUTO_SEED=1
